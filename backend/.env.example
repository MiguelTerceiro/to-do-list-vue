PORT=3000
JWT_SECRET=troca-esta-chave

# Obrigatorio para comandos Prisma como generate/migrate.
# O utilizador MySQL precisa de permissao para CREATE DATABASE na primeira execucao.
DATABASE_URL="mysql://root:password@localhost:3306/todo_app"

# Opcional no runtime: o backend tambem aceita estas variaveis e monta a ligacao.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=todo_app

GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
